{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cenn0/Packory/blob/main/docs/contracts/validation-export-v1.schema.json",
  "title": "Sanitized validation results export, envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alias",
    "audience",
    "tenant",
    "source_digest",
    "run_binding_digest",
    "evidence_digest",
    "verifier_key_id",
    "issued_at",
    "expires_at",
    "status",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verifier_key_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    }
  }
}
